<odoo>
     <record id="view_fleet_vehicle_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='tag_ids']" position="before">
                <label for="code" />
                <h2>
                    <field name="code" class="oe_inline" />
                </h2>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_tree_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='license_plate']" position="after">
                <field name="code" />
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.search</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search" />
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute
                    name="filter_domain"
                >['|', '|', ('name', 'ilike', self), ('license_plate', 'ilike', self), ('code', 'ilike', self)]</attribute>
            </field>
            <field name="name" position="after">
                <field string="Vehicle Code" name="code" />
            </field>
        </field>
    </record>
</odoo>
