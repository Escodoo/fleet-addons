<odoo>
    <record id="fleet_vehicle_view_form_inherit_maintenance" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.maintenance</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_maintenance_requests"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-wrench"
                >
                    <field
                        name="maintenance_request_count"
                        widget="statinfo"
                        string="Maintenances"
                    />
                </button>
            </xpath>
        </field>
    </record>

    <record id="maintenance_request_with_vehicle_action" model="ir.actions.act_window">
        <field name="name">Maintenances</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('equipment_id.fleet_vehicle_id', '!=', False)]</field>
    </record>

    <menuitem
        id="fleet_maintenance_menu"
        name="Maintenances"
        parent="fleet.fleet_vehicles"
        action="maintenance_request_with_vehicle_action"
        sequence="21"
        groups="fleet.fleet_group_user"
    />
</odoo>
