<odoo>
    <record id="view_fuel_consume_wizard_form" model="ir.ui.view">
        <field name="name">fuel.consume.wizard.form</field>
        <field name="model">fuel.consume.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Fuel Consumption">
                <sheet>
                    <group>
                        <group string="Vehicle">
                            <field name="vehicle_id" />
                            <field name="driver_id" />
                            <field name="odometer_value" />
                        </group>
                        <group string="Operation">
                            <field name="picking_type_id" />
                            <field name="location_id" />
                            <field name="product_id" />
                            <field name="product_uom_id" invisible="1" />
                            <field name="product_uom_qty" />
                            <field name="available_qty" />
                        </group>
                    </group>
                    <group string="Analytic">
                        <field
                            name="analytic_distribution"
                            string="Analytic Distribution"
                            widget="analytic_distribution"
                            options="{'business_domain': 'stock_move'}"
                        />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_next"
                        string="Next"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fuel_consume_wizard" model="ir.actions.act_window">
        <field name="name">Register Fuel Consumption</field>
        <field name="res_model">fuel.consume.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_fuel_consume_wizard"
        name="Fuel Consumption"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_fuel_consume_wizard"
        sequence="30"
    />
</odoo>
