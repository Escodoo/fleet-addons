<odoo>
    <record id="stock_picking_form_inherit_fuel_consumption" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.fuel.consumption</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="picking_type_is_fuel_consumption" invisible="1" />
                <field
                    name="vehicle_id"
                    attrs="{'invisible': [('picking_type_is_fuel_consumption', '=', False)]}"
                />
                <field
                    name="driver_id"
                    attrs="{'invisible': [('picking_type_is_fuel_consumption', '=', False)]}"
                />
                <field
                    name="odometer_value"
                    attrs="{'invisible': [('picking_type_is_fuel_consumption', '=', False)]}"
                />
            </xpath>
            <xpath
                expr="//field[@name='move_ids_without_package']//tree//field[@name='product_id']"
                position="after"
            >
                <field name="vehicle_id" optional="show" />
                <field name="driver_id" optional="show" />
            </xpath>
        </field>
    </record>

</odoo>
