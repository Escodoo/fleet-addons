<odoo>
    <record id="stock_picking_type_form_inherit_fuel_consumption" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.fuel.consumption</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="is_fuel_consumption" />
            </xpath>
        </field>
    </record>

</odoo>
