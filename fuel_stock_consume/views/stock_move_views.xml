<odoo>
    <record id="view_move_tree_inherit_fuel_consumption" model="ir.ui.view">
        <field name="name">stock.move.tree.inherit.fuel.consumption</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="vehicle_id" optional="show" />
                <field name="driver_id" optional="show" />
                <field name="odometer_value" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_stock_move_action" model="ir.actions.act_window">
        <field name="name">Stock Moves</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="view_id" ref="stock.view_move_tree" />
        <field name="search_view_id" ref="stock.view_move_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stock move found for this vehicle
            </p>
            <p>
                Stock moves are linked to a vehicle through the fuel
                consumption operations performed for it.
            </p>
        </field>
    </record>
</odoo>
