<odoo>
    <record id="fleet_vehicle_form_inherit_fuel_consumption" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.fuel.consumption</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_fuel_consume_wizard"
                    string="Fuel Consumption"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tint"
                />
            </xpath>
            <xpath expr="//field[@name='driver_id']" position="after">
                <field name="fuel_consumption_location_id" />
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_tree_inherit_fuel_consumption" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree.inherit.fuel.consumption</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='license_plate']" position="after">
                <field name="fuel_consumption_location_id" />
            </xpath>
        </field>
    </record>
</odoo>
