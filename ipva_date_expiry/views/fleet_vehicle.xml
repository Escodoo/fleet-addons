<odoo>

    <record model="ir.ui.view" id="fleet_vehicle_form_view">
        <field name="name">fleet.vehicle.form (in ipva_date_expiry)</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <field name="vin_sn" position="before">
                <field name="ipva_expiry_date" />
            </field>
        </field>
    </record>

    <record id="fleet_vehicle_view_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree (in ipva_date_expiry)</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree" />
        <field name="arch" type="xml">
            <field name="activity_exception_decoration" position="after">
                <field name="ipva_expiry_date" optional="hide" />
                <field name="ipva_days_to_expire" optional="hide" />
                <field
                    name="ipva_expiry_state"
                    optional="hide"
                    widget="badge"
                    decoration-success="ipva_expiry_state == 'valid'"
                    decoration-warning="ipva_expiry_state == 'expiring_soon'"
                    decoration-danger="ipva_expiry_state == 'expired'"
                />
            </field>
        </field>
    </record>

    <record id="fleet_vehicle_view_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.search (in ipva_date_expiry)</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter
                    string="IPVA Expired"
                    name="ipva_expired"
                    domain="[('ipva_expiry_state', '=', 'expired')]"
                />
                <filter
                    string="IPVA Expiring Soon"
                    name="ipva_expiring_soon"
                    domain="[('ipva_expiry_state', '=', 'expiring_soon')]"
                />
                <filter
                    string="IPVA Valid"
                    name="ipva_valid"
                    domain="[('ipva_expiry_state', '=', 'valid')]"
                />
                <separator />
            </xpath>
        </field>
    </record>

</odoo>
